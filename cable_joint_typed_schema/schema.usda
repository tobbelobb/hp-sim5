#usda 1.0
(
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "CableJointSchema"
        string libraryPath = ""
        string libraryPrefix = "CableJoint"
        bool skipCodeGeneration = true
    }
) {
}

class CableJoint "CableJoint" (
    inherits = </UsdPhysicsJoint>
    customData = {
        string className = "CableJoint"
        string doc = """A cable joint constraint that connects two rigid bodies with a flexible cable.

        CableJoint represents a unilateral distance constraint - it prevents the connected bodies
        from moving farther apart than the rest length, but allows them to move closer together
        (creating slack in the cable). This is fundamentally different from a bilateral
        DistanceJoint which maintains a fixed distance.

        Cable joints are typically used in sequences to model flexible cables, ropes, or chains
        connecting multiple objects in a scene.
        """
    }
)
{
    double restLength = 1.0 (
        doc = """Rest length of the cable segment in world units.

        This is the natural length of the cable when no tension is applied.
        The cable constraint becomes active when the distance between attachment
        points exceeds this rest length.
        """
    )

    point3d localPos0 = (0, 0, 0) (
        doc = """Local attachment point on body0 (first connected body).

        This point is specified in the local coordinate system of body0.
        The cable constraint acts between this point and localPos1 on body1.
        """
    )

    point3d localPos1 = (0, 0, 0) (
        doc = """Local attachment point on body1 (second connected body).

        This point is specified in the local coordinate system of body1.
        The cable constraint acts between localPos0 on body0 and this point.
        """
    )

    double stiffness = 1000.0 (
        doc = """Stiffness of the cable constraint in N/m.

        Higher values create a stiffer cable that resists stretching more strongly.
        Lower values allow more elastic behavior.
        """
    )

    double damping = 10.0 (
        doc = """Damping coefficient for the cable constraint in N*s/m.

        Damping reduces oscillations and helps stabilize the cable simulation.
        Higher values provide more damping but may make the cable feel sluggish.
        """
    )

    bool allowSlack = true (
        doc = """Whether the cable allows slack (unilateral constraint).

        When true (default), the cable only prevents separation beyond restLength
        but allows the bodies to move closer together, creating slack.
        When false, the cable acts as a bilateral constraint maintaining fixed distance.
        """
    )

    double maxForce = -1.0 (
        doc = """Maximum force the cable can exert before breaking, in Newtons.

        If positive, the cable will break (disable) when the constraint force
        exceeds this threshold. If negative (default), the cable never breaks.
        """
    )

    bool enabled = true (
        doc = """Whether this cable joint constraint is active.

        Disabled cable joints do not participate in simulation but remain
        in the scene for potential re-enabling later.
        """
    )

    token constraintType = "unilateral" (
        allowedTokens = ["unilateral", "bilateral"]
        doc = """Type of distance constraint imposed by the cable.

        'unilateral': Cable prevents separation beyond restLength but allows slack
        'bilateral': Cable maintains exactly restLength distance (no slack)
        """
    )
}

class "CablePathAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        string className = "CablePathAPI"
        string doc = """API schema for cable paths that define sequences of CableJoint prims.

        A cable path represents a continuous cable that passes through multiple
        attachment points, implemented as a sequence of CableJoint constraints.
        This API provides path-level properties and routing information.
        """
    }
)
{
    rel cableJoints[] (
        doc = """Ordered sequence of CableJoint prims that make up this cable path.

        The cable path is defined by the sequential connection of these joints.
        Each joint connects two bodies, and adjacent joints in the sequence
        should share a common body to form a continuous path.
        """
    )

    token[] linkTypes (
        doc = """Type of link for each segment in the cable path.

        Defines how the cable interacts with each body along the path.
        Common types: 'attachment' (fixed to body), 'rolling' (can slide around body),
        'hybrid-attachment' (attachment with some sliding capability).
        """
    )

    bool[] clockwise (
        doc = """Direction of cable routing around each body in the path.

        For bodies where the cable wraps around (rolling contacts),
        specifies whether the cable follows a clockwise path around that body.
        """
    )

    double[] storedLength (
        doc = """Amount of cable stored or wound at each segment.

        Represents cable length that is wound up or stored at each body,
        affecting the effective length of each cable segment.
        """
    )

    double totalLength (
        doc = """Total physical length of the cable in the path.

        This is the sum of all segment rest lengths plus any stored lengths.
        Used for path-level calculations and cable management.
        """
    )

    bool enabled = true (
        doc = """Whether this cable path is active.

        When disabled, all CableJoint constraints in the path are deactivated.
        """
    )

    double tension = 0.0 (
        doc = """Current tension in the cable path.

        Runtime property representing the overall tension state of the cable.
        Updated during simulation based on constraint forces.
        """
    )
}
