            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }


        def Xform "Extruder" ()
        {
            token[] ecs:tags = ["Extruder"]
            # Local extruder frame:
            # - origin = average(machine:centerSources)
            # - child xformOp:translate values are local offsets in that frame
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel machine:centerSources = [
                </World/HangprinterScene/AttachAL>,
                </World/HangprinterScene/AttachAR>,
                </World/HangprinterScene/AttachBR>
            ]
            rel machine:rigidBody = </World/HangprinterScene/Effector>
            rel material:binding = </World/PhysicsScene/AnchorMaterial>

            def Xform "ColdEnd" ()
            {
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "Tip" ()
            {
                double3 xformOp:translate = (0, 0, -0.1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

