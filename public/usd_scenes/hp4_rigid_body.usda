#usda 1.0
(
    doc = "A USD scene for Hangprinter v4"
    defaultPrim = "HangprinterScene"
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 500
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "HangprinterScene"
    {
        def Circle "SpoolA" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, -2.54, -0.18)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = -1.0
            float3 physics:angularVelocity = (0, 0, 0)
            # Typical intertia range for Nema 17 stepper motors are ca 3e-5 to 8e-5.
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.011
            vector3f physics:velocity = (0, 0, 0)
        }

        def Xform "AnchorAL_top" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (-0.346410161513775, -2.14, -0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "AnchorAL_bottom" ()
        {
            token[] ecs:tags = ["Anchor"]
            # Distance between vertical action point holes is 59.5 mm. Gotten from hangprinter/src/corner_clamp.scad
            # Like this: echo("dist:", higher_bearing_z + b623_big_ugroove_small_r + Eyelet_extra_dist - (lower_bearing_z - b623_big_ugroove_small_r - Eyelet_extra_dist));
            double3 xformOp:translate = (-0.346410161513775, -2.14, -0.2395)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "AnchorAR_top" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (0.346410161513775, -2.14, -0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "AnchorAR_bottom" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (0.346410161513775, -2.14, -0.2395)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "WheelAL_top" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Wheel"]
            # radius taken from bearing_u_big_623.scad in the hangprinter repo. d=14.1 (mm) => r=7.05 mm == 0.00705 m
            # in corner_clamp.scad however, the radius is 6.5 mm so we'll use that
            double radius = 0.0065
            # 0.1-0.0065 = 0.0935
            # Then there's an Eyelet_extra_dist = 0.75
            # 0.1 - 0.0065 - 0.00075 = 0.09275
            double3 xformOp:translate = (-0.346410161513775, -0.22, 0.09275)
            double3 xformOp:rotateXYZ = (0, 90, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:translate"]
            # Typical mass of a 623 bearing is 2 g
            float physics:mass = 0.002
            # Typical rotational inertia of a 623 bearing is 3e-8. Our outer pla ring adds a little bit so say 5e-8
            matrix3d physics:inertiaTensor = ((5e-8, 0, 0), (0, 5e-8, 0), (0, 0, 5e-8))
            vector3f physics:velocity = (0, 0, 0)
            float3 physics:angularVelocity = (0, 0, 0)
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "PinholeAL_top" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Pinhole"]
            double3 xformOp:translate = (-0.346410161513775, -0.24, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            float physics:mass = 0.0002
            vector3f physics:velocity = (0, 0, 0)
            float3 physics:angularVelocity = (0, 0, 0)
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "WheelAL_bottom" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Wheel"]
            double radius = 0.0065
            # Corner_clamp_bearings_center_to_center = 45 in hangprinter/src/lib/parameters.scad
            # 0.1 - 0.0065 - 0.00075 - 0.045 = 0.04775
            double3 xformOp:translate = (-0.346410161513775, -0.22, 0.04775)
            double3 xformOp:rotateXYZ = (0, 90, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:translate"]
            float physics:mass = 0.002
            matrix3d physics:inertiaTensor = ((5e-8, 0, 0), (0, 5e-8, 0), (0, 0, 5e-8))
