        def Sphere "Extruder" ()
        {
            token[] ecs:tags = ["Extruder"]
            double radius = 0.01
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel machine:centerSources = [
                </World/HangprinterScene/AttachAL>,
                </World/HangprinterScene/AttachAR>,
                </World/HangprinterScene/AttachBR>,
                </World/HangprinterScene/AttachCR>
            ]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        # Group the attachment points into a rigid cluster for simulation
        def RigidGroup "Effector"
        {
            rel rigidGroup:members = [
                </World/HangprinterScene/AttachAL>,
                </World/HangprinterScene/AttachAR>,
                </World/HangprinterScene/AttachBR>,
                </World/HangprinterScene/AttachCR>
            ]
        }

        def CableJoint "JointAL_0"
        {
            custom point3d localPos0 = (0.0004484442179648312, 0.02999664810913659, 0)
            custom point3d localPos1 = (0, 0, 0)
            custom rel physics:body0 = </World/HangprinterScene/SpoolA>
            custom rel physics:body1 = </World/HangprinterScene/AnchorAL>
            custom double restLength = 0.528299157674891
