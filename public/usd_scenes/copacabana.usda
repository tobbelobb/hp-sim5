        # Initial span and storage tensions apply the explicit sqrt(2) factor for the 90 deg
        # carriage-pulley force sensor (Trautwein et al. 2020 Fig. 4) to the raw P0 readings
        # [64.0, 60.1, 64.0, 59.5, 28.4, 24.7, 25.2, 21.8] N so home vertical force matches 13.9 kg.
        def Xform "CablePathA" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1, 1]
            custom rel cablePath:joints = [</World/HangprinterScene/JointA_0>, </World/HangprinterScene/JointA_1>]
            custom token[] cablePath:linkTypes = ["hybrid", "rolling", "attachment"]
            custom double[] cablePath:stored = [3.0, 0 ,0]
            custom double cablePath:initialTension = 90.51
            custom double cablePath:initialStorageTension = 90.51
            custom double cablePath:stiffnessPerUnitLength = 83800.0
            custom double cablePath:dampingPerUnitLength = 5.0
            custom double cablePath:halfWidth = 0.0
            custom token[] cablePath:storedMode = ["manual", "auto", "manual"]
            custom token cablePath:initPolicy = "deriveMissing"
        }

