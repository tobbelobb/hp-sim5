#usda 1.0
(
    doc = "A better USD scene for Slideprinter"
    defaultPrim = "SlideprinterScene"
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 500
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "SlideprinterScene" {
        def Circle "SpoolA" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.030010606910511, -0.197735589798253, 0.000000000000000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            # Mass should really be 0.11111 to match a 5e-5 rotational inertia with a radius of 0.03...
            float physics:mass = 0.027
            float3 physics:angularVelocity = (0, 0, 0)
            # Typical intertia range for Nema 17 stepper motors are ca 3e-5 to 8e-5.
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.011
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorA" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (0.0, -2.1, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "SpoolB" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.156238740542330, 0.124857742866617, 0.000000000000000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.027
            float3 physics:angularVelocity = (0, 0, 0)
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.011
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorB" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (1.818653347947321, 1.05, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "SpoolC" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.186249347452841, 0.072877846931635, 0.000000000000000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.027
            float3 physics:angularVelocity = (0, 0, 0)
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            custom double stepper:holdingTorque = 0.5
            custom int stepper:numPolePairs = 50
            custom double stepper:dampingCoeff = 0.011
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorC" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (-1.818653347947321, 1.05, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def RigidBody "Effector"
        {
            rel rigidBody:members = [
                </World/SlideprinterScene/SpoolA>,
                </World/SlideprinterScene/SpoolB>,
                </World/SlideprinterScene/SpoolC>
            ]
        }

        def CableJoint "JointA"
        {
            custom point3d localPos0 = (0.0, 0.0, 0.0)
            custom point3d localPos1 = (-0.029999999999534, 0.000000167278166, 0.000000000000000)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorA>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolA>
            custom double restLength = 1.902264577509485
        }

        def CableJoint "JointB"
        {
            custom point3d localPos0 = (0.0, 0.0, 0.0)
            custom point3d localPos1 = (0.014999855132626, -0.025980845752212, 0.000000000000000)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorB>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolB>
            custom double restLength = 1.902264577509485
        }

        def CableJoint "JointC"
        {
            custom point3d localPos0 = (0.0, 0.0, 0.0)
            custom point3d localPos1 = (0.015000144866908, 0.025980678474047, 0.000000000000000)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorC>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolC>
            custom double restLength = 1.902264577509485
        }

        def Xform "CablePathA" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1]
            custom rel cablePath:joints = [</World/SlideprinterScene/JointA>]
            custom token[] cablePath:linkTypes = ["attachment", "hybrid"]
            custom double[] cablePath:stored = [0, 1.0]
            custom double stiffness = 20000.0
            custom double cablePath:halfWidth = 0.001
        }

        def Xform "CablePathB" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1]
            custom rel cablePath:joints = [</World/SlideprinterScene/JointB>]
            custom token[] cablePath:linkTypes = ["attachment", "hybrid"]
            custom double[] cablePath:stored = [0, 1.0]
            custom double stiffness = 20000.0
            custom double cablePath:halfWidth = 0.001
        }

        def Xform "CablePathC" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1]
            custom rel cablePath:joints = [</World/SlideprinterScene/JointC>]
            custom token[] cablePath:linkTypes = ["attachment", "hybrid"]
            custom double[] cablePath:stored = [0, 1.0]
            custom double stiffness = 20000.0
            custom double cablePath:halfWidth = 0.001
        }

        def Xform "Extruder" ()
        {
            token[] ecs:tags = ["Extruder"]
            # Local extruder frame:
            # - origin = average(machine:centerSources)
            # - child xformOp:translate values are local offsets in that frame
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel machine:centerSources = [
                </World/SlideprinterScene/SpoolA>,
                </World/SlideprinterScene/SpoolB>,
                </World/SlideprinterScene/SpoolC>
            ]
            rel machine:rigidBody = </World/SlideprinterScene/SpoolTriangle>
            rel material:binding = </World/PhysicsScene/AnchorMaterial>

            def Xform "Tip" ()
            {
                double3 xformOp:translate = (0.0, 0.0, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "ColdEnd" ()
            {
                double3 xformOp:translate = (0.0, 0.0, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
        custom color3f machine:tintColor = (0.5, 0.0, 0.5)
        custom color3f machine:extrusionColor = (0.7, 0.0, 0.7)
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.82
        def Material "SpoolMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.2
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0.5
        }

        def Material "AnchorMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
             def Shader "Shader"
             {
                 color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
             }
        }
    }
}
