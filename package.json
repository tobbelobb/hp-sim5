{
  "name": "cable_joints",
  "version": "1.0.0",
  "type":"module",
  "main": "src/js/cable_joints/cable_joints_core.js",
  "scripts": {
    "test": "jest",
    "probe:spool-energy": "node tests/benchmark/spool_energy_probe.mjs --steps 4000 --report tests/benchmark/spool_energy_report_latest.json",
    "probe:spool-energy:gate": "node tests/benchmark/spool_energy_probe.mjs --steps 4000 --fail-on-unsolved --report tests/benchmark/spool_energy_report_latest.json",
    "probe:spool-energy:hard": "node tests/benchmark/spool_energy_probe.mjs --steps 4000 --analysis-start-step 500 --config-json '{\"initialStoredTurns\":1.5,\"cableHalfWidth\":0.0035,\"cableStiffness\":1400,\"initialLinearSpeed\":1.2,\"restLengthScale\":1,\"ballRadius\":0.04,\"ballMass\":0.008,\"borderFriction\":0.6,\"cw\":true}' --jump-delta-e-threshold 0.00025 --max-positive-delta-e 0.0003 --max-jump-episodes 0 --min-stored-gain 0.2 --report tests/benchmark/spool_energy_report_hard_latest.json",
    "probe:spool-energy:hard:gate": "node tests/benchmark/spool_energy_probe.mjs --steps 4000 --analysis-start-step 500 --config-json '{\"initialStoredTurns\":1.5,\"cableHalfWidth\":0.0035,\"cableStiffness\":1400,\"initialLinearSpeed\":1.2,\"restLengthScale\":1,\"ballRadius\":0.04,\"ballMass\":0.008,\"borderFriction\":0.6,\"cw\":true}' --jump-delta-e-threshold 0.00025 --max-positive-delta-e 0.0003 --max-jump-episodes 0 --min-stored-gain 0.2 --fail-on-unsolved --report tests/benchmark/spool_energy_report_hard_latest.json",
    "probe:spool-energy:funnel": "node tests/benchmark/spool_energy_probe.mjs --scene-path examples/js/flipper/spool_energy_funnel_debug.html --steps 140 --analysis-start-step 1 --max-substeps 1 --jump-delta-e-threshold 0.0005 --max-positive-delta-e 0.00055 --max-jump-episodes 0 --report tests/benchmark/spool_energy_funnel_report_latest.json",
    "probe:spool-energy:funnel:gate": "node tests/benchmark/spool_energy_probe.mjs --scene-path examples/js/flipper/spool_energy_funnel_debug.html --steps 140 --analysis-start-step 1 --max-substeps 1 --jump-delta-e-threshold 0.0005 --max-positive-delta-e 0.00055 --max-jump-episodes 0 --fail-on-unsolved --report tests/benchmark/spool_energy_funnel_report_latest.json",
    "probe:spool-energy:funnel:hard": "node tests/benchmark/spool_energy_probe.mjs --scene-path examples/js/flipper/spool_energy_funnel_debug.html --steps 800 --analysis-start-step 141 --max-substeps 1 --jump-delta-e-threshold 0.0005 --max-positive-delta-e 0.0005 --max-jump-episodes 0 --report tests/benchmark/spool_energy_funnel_report_hard_latest.json",
    "probe:spool-energy:funnel:hard:gate": "node tests/benchmark/spool_energy_probe.mjs --scene-path examples/js/flipper/spool_energy_funnel_debug.html --steps 800 --analysis-start-step 141 --max-substeps 1 --jump-delta-e-threshold 0.0005 --max-positive-delta-e 0.0005 --max-jump-episodes 0 --fail-on-unsolved --report tests/benchmark/spool_energy_funnel_report_hard_latest.json"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "puppeteer": "^24.8.2",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@kroxilon/usda-parser": "^0.0.4",
    "fast-glob": "^3.3.3",
    "three": "^0.177.0"
  }
}
