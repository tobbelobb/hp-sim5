        def Xform "Extruder" ()
        {
            token[] ecs:tags = ["Extruder"]
            double3 xformOp:translate = (0.0, 0.0, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel machine:centerSources = [
                </World/HangprinterScene/AttachI>,
                </World/HangprinterScene/AttachJ>,
                </World/HangprinterScene/AttachL>,
                </World/HangprinterScene/AttachO>
            ]
            rel machine:rigidBody = </World/HangprinterScene/Effector>
            rel material:binding = </World/PhysicsScene/AnchorMaterial>

            def Xform "ColdEnd" ()
            {
                double3 xformOp:translate = (0.0, 0.0, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Xform "Tip" ()
            {
                double3 xformOp:translate = (0.0, 0.0, -0.1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        # Group the attachment points into a rigid cluster for simulation
        def RigidBody "Effector"
        {
            rel rigidBody:members = [
                </World/HangprinterScene/AttachA>,
                </World/HangprinterScene/AttachB>,
                </World/HangprinterScene/AttachC>,
                </World/HangprinterScene/AttachD>,
                </World/HangprinterScene/AttachI>,
                </World/HangprinterScene/AttachJ>,
                </World/HangprinterScene/AttachL>,
                </World/HangprinterScene/AttachO>
            ]

            custom string rigidBody:renderIndices = "[[0,1], [0,3], [0,4], [1,2], [1,5], [2,3], [2,6], [3,7], [4,5], [4,7], [5,6], [6,7]]"
        }

