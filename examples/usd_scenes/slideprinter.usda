#usda 1.0
(
    doc = "A better USD scene for Slideprinter"
    defaultPrim = "SlideprinterScene"
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 500
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "SlideprinterScene" {
        def Circle "SpoolA" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.0, -0.1, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.025
            float3 physics:angularVelocity = (0, 0, 0)
            # Typical intertia range for Nema 17 stepper motors are ca 3e-5 to 8e-5.
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorA" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (0.0, -2.1, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "PinholeA" ()
        {
            token[] ecs:tags = ["Pinhole"]
            double3 xformOp:translate = (0.0, -0.2, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "SpoolB" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.08660254, 0.05, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.025
            float3 physics:angularVelocity = (0, 0, 0)
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorB" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (1.776, 1.025, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "PinholeB" ()
        {
            token[] ecs:tags = ["Pinhole"]
            double3 xformOp:translate = (0.1732208773, 0.0999726347, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Circle "SpoolC" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            token[] ecs:tags = ["Spool", "Stepper"]
            rel material:binding = </World/PhysicsScene/SpoolMaterial>
            custom bool cable:linkable = 1
            double radius = 0.03
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.08660254, 0.05, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.025
            float3 physics:angularVelocity = (0, 0, 0)
            matrix3d physics:inertiaTensor = ((5e-5, 0, 0), (0, 5e-5, 0), (0, 0, 5e-5))
            vector3f physics:velocity = (0.0, 0.0, 0.0)
        }

        def Xform "AnchorC" ()
        {
            token[] ecs:tags = ["Anchor"]
            double3 xformOp:translate = (-1.776, 1.025, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        def Xform "PinholeC" ()
        {
            token[] ecs:tags = ["Pinhole"]
            double3 xformOp:translate = (-0.1732208773, 0.0999726347, 0.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/PhysicsScene/AnchorMaterial>
        }

        # Group the three spools into a rigid cluster for simulation
        def RigidGroup "SpoolTriangle"
        {
            rel rigidGroup:members = [
                </World/SlideprinterScene/SpoolA>,
                </World/SlideprinterScene/SpoolB>,
                </World/SlideprinterScene/SpoolC>
            ]
        }

        def CableJoint "JointA_0"
        {
            custom point3d localPos0 = (0.0, -2.1, 0.0)
            custom point3d localPos1 = (0.0, -0.2, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorA>
            custom rel physics:body1 = </World/SlideprinterScene/PinholeA>
            custom double restLength = 1.9
        }

        def CableJoint "JointA_1"
        {
            custom point3d localPos0 = (0.0, -0.2, 0.0)
            custom point3d localPos1 = (-0.029997, -0.10045, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/PinholeA>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolA>
            custom double restLength = 0.1039712581
        }

        def CableJoint "JointB_0"
        {
            custom point3d localPos0 = (1.776, 1.025, 0.0)
            custom point3d localPos1 = (0.1732208773, 0.0999726347, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorB>
            custom rel physics:body1 = </World/SlideprinterScene/PinholeB>
            custom double restLength = 1.850561143
        }

        def CableJoint "JointB_1"
        {
            custom point3d localPos0 = (0.1732208773, 0.0999726347, 0.0)
            custom point3d localPos1 = (0.1020, 0.0243, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/PinholeB>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolB>
            custom double restLength = 0.1039170871
        }

        def CableJoint "JointC_0"
        {
            custom point3d localPos0 = (-1.776, 1.025, 0.0)
            custom point3d localPos1 = (-0.1732208773, 0.0999726347, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/AnchorC>
            custom rel physics:body1 = </World/SlideprinterScene/PinholeC>
            custom double restLength = 1.850561143
        }

        def CableJoint "JointC_1"
        {
            custom point3d localPos0 = (-0.1732208773, 0.0999726347, 0.0)
            custom point3d localPos1 = (-0.0720, 0.0762, 0.0)
            custom rel physics:body0 = </World/SlideprinterScene/PinholeC>
            custom rel physics:body1 = </World/SlideprinterScene/SpoolC>
            custom double restLength = 0.103975017
        }

        def Xform "CablePathA" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1, 1]
            custom rel cablePath:joints = [</World/SlideprinterScene/JointA_0>, </World/SlideprinterScene/JointA_1>]
            custom token[] cablePath:linkTypes = ["attachment", "pinhole", "hybrid"]
            custom double[] cablePath:stored = [0, 0, 0.942478]
            custom double cablePath:totalLength = 2.946449258
            custom double stiffness = 20000.0
        }

        def Xform "CablePathB" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1, 1]
            custom bool cablePath:enabled = 1
            custom rel cablePath:joints = [</World/SlideprinterScene/JointB_0>, </World/SlideprinterScene/JointB_1>]
            custom token[] cablePath:linkTypes = ["attachment", "pinhole", "hybrid"]
            custom double[] cablePath:stored = [0, 0, 0.942478]
            custom double cablePath:totalLength = 2.89695623
            custom double stiffness = 20000.0
        }

        def Xform "CablePathC" (
            apiSchemas = ["CablePathAPI"]
        )
        {
            custom bool[] cablePath:clockwise = [1, 1, 1]
            custom bool cablePath:enabled = 1
            custom rel cablePath:joints = [</World/SlideprinterScene/JointC_0>, </World/SlideprinterScene/JointC_1>]
            custom token[] cablePath:linkTypes = ["attachment", "pinhole", "hybrid"]
            custom double[] cablePath:stored = [0, 0, 0.942478]
            custom double cablePath:totalLength = 2.89701416
            custom double stiffness = 20000.0
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, 0)
        float physics:gravityMagnitude = 0.0
        def Material "SpoolMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            def Shader "Shader"
            {
                color3f inputs:diffuseColor = (0.5, 0.0, 0.5)
            }
            float physics:staticFriction = 0.2
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0.5
        }

        def Material "AnchorMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
             def Shader "Shader"
             {
                 color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
             }
        }
    }
}
