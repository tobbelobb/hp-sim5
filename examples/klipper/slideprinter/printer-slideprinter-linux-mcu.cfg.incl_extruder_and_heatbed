# Slideprinter config for Klipper, the mcu part running as a Linux process
# - The fake pin chip must be created first by make-fake-pin-chip.sh <point_to_this_file>
#   It makes sure to not collide with any real gpio pins on your system
#   It will replace REPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER with the number of the fake gpio chip

[mcu]
serial: /tmp/klipper_host_mcu

[printer]
kinematics: winch
max_velocity: 300
max_accel: 3000
flex_compensation_enable: false
winch_mover_weight: 0.006
winch_spring_constant: 20000.0
winch_min_force: 2.5, 2.5, 2.5
winch_max_force: 170, 170, 170
winch_guy_wire_lengths: 528.3, 528.3, 528.3
flex_compensation_algorithm: qp
ignore_gravity: true
ignore_pretension: false

[stepper_a]
step_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio0
dir_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio1
enable_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio2
microsteps: 16
rotation_distance: 188.496
anchor_x: 0
anchor_y: -1900
anchor_z: 0

[stepper_b]
step_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio3
dir_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio4
enable_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio5
microsteps: 16
rotation_distance: 188.496
anchor_x: 1645.448267190434
anchor_y: 950
anchor_z: 0

[stepper_c]
step_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio6
dir_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio7
enable_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio8
microsteps: 16
rotation_distance: 188.496
anchor_x: -1645.448267190434
anchor_y: 950
anchor_z: 0

[stepper_d]
step_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio9
dir_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio10
enable_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio11
microsteps: 16
rotation_distance: 188.496
anchor_x: 0
anchor_y: 0
anchor_z: 2000


[extruder]
step_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio12
dir_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio13
enable_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio14
microsteps: 16
rotation_distance: 33.500
nozzle_diameter: 0.400
filament_diameter: 1.750
# Heater output uses a PWM-capable pin on Linux MCU. Placeholder kept
# as a regular GPIO here; see make-fake-pin-chip.sh for notes on Linux
# hardware PWM (pwmchipX/pwmY) if you need it.
heater_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio15
sensor_type: EPCOS 100K B57560G104F
# Analog temperature sensor input via Linux IIO (analogN)
# The script make-fake-pin-chip.sh replaces this placeholder with
# a name like "analog0" after creating an IIO dummy device.
sensor_pin: REPLACE_ME_WITH_FAKE_ANALOG_PIN_0
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: 0
min_extrude_temp: 0
max_temp: 275

[heater_bed]
# Heater output uses a PWM-capable pin on Linux MCU. Placeholder kept
# as a regular GPIO here; see make-fake-pin-chip.sh for notes on Linux
# hardware PWM (pwmchipX/pwmY) if you need it.
heater_pin: gpiochipREPLACE_ME_WITH_FAKE_GPIO_CHIP_NUMBER/gpio17
sensor_type: EPCOS 100K B57560G104F
# Analog temperature sensor input via Linux IIO (analogN)
# The script make-fake-pin-chip.sh replaces this placeholder with
# a name like "analog1" after creating an IIO dummy device.
sensor_pin: REPLACE_ME_WITH_FAKE_ANALOG_PIN_1
control: watermark
min_temp: 0
max_temp: 130

[force_move]
enable_force_move: True
