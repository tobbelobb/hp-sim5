#!/usr/bin/env bash
set -e
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Program bookkeeping uses only the standard library. Worker physics still
# requires the fully installed project environment.
python="$repo_dir/.venv/bin/python"
if [[ ! -x "$python" ]]; then
    python=python3
fi
exec "$python" "$repo_dir/research-program/cli.py" "$@"
