            custom token[] cablePath:linkTypes = ["hybrid", "pinhole", "pinhole", "rolling", "rolling", "pinhole", "attachment"]
            custom int cablePath:solverIterations = 2
            custom double cablePath:stiffness = 20000
            custom double[] cablePath:stored = [2, 0, 0, 0, 0, 0, 0]
