{
  "version": 1,
  "claim": "Eleven new, one-command reproducible incorrect behaviours in hp-sim5 (upload extrusion accounting, quality-record timing, bridge lifecycle, native telemetry/recording content, passive-wheel inertia, gyroscopic integration, and worker pacing), each with quantitative expected-vs-actual evidence; the strongest findings plus key negative controls are included.",
  "scope": "Simulator evidence on one host, revision 74ecdc95 plus research-only evidence commit; no hardware validation, no browser automation. Findings 5-7 use the checked-in native addon; finding 5 was also reproduced on the checked-in Wasm build.",
  "limitations": [
    "No browser/UI automation; UI-adjacent defects use stubbed workers/sockets and production modules.",
    "The quality-history reproducer mirrors four boundary source lines because workerController imports Vite-only modules; it fails on source drift.",
    "Finding 8 (ignored passive-wheel inertia) is a minimal Atwood, not an end-to-end machine run; the machine-level consequence is inferred.",
    "Finding 9 (no gyroscopic term) is latent: shipped bodies are symmetric.",
    "Generated .rrd recordings are not in the selection; evidence JSON summaries are."
  ],
  "candidate_revision": "212c56ea7b894cf0e138590e1fa750a522aadbb6",
