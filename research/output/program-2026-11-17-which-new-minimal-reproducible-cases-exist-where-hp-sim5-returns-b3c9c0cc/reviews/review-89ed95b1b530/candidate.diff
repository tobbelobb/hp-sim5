+    [{ a: 1, b: 0, rest, pa: P(s * (r + 1e-9), -1), pb: P(s * r, 0) },
+      { a: 0, b: 2, rest, pa: P(-s * r, 0), pb: P(-s * (r + 1e-9), -1) }],
