+globalThis.postMessage = () => {};
+globalThis.self = { addEventListener() {}, onmessage: null, postMessage: globalThis.postMessage, console };
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
