+    const closest = p1.clone().add(ab, t).distanceTo(c);
+    const outside = p1.distanceTo(c) > r && p2.distanceTo(c) > r;
+    const reference = outside ? closest <= r : false;
+    if (got !== reference && Math.abs(closest - r) / r > 1e-9) gross += 1;
