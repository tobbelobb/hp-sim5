#usda 1.0
(
    timeCodesPerSecond = 500
)
def Xform "World" {
    double3 xformOp:translate = (1, 2, 3)
    double3 xformOp:rotateZYX = (20, 30, 40)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX"]
    def Xform "Scene" {
        double3 xformOp:translate = (0.1, -0.2, 0.3)
        quatd xformOp:orient = (0.9238795325112867, 0, 0.3826834323650898, 0)
        uniform token[] xformOpOrder = ["xformOp:orient", "xformOp:translate"]
        def Xform "A" {
            double radius = 0.03
            double3 xformOp:translate = (-1, 0, 0)
        }
        def Xform "B" {
            double radius = 0.1
            double3 xformOp:translate = (0, 0.5, 0.2)
            double3 xformOp:rotateXYZ = (0, 0, 30)
        }
        def Xform "C" {
            double radius = 0.08
            double3 xformOp:translate = (1, 0, 0.4)
            double3 spool:axisLocal = (1, 0, 0)
        }
        def Xform "D" {
            double3 xformOp:translate = (2, -0.5, 0.2)
        }
        def CableJoint "J0" {
            rel physics:body0 = </World/Scene/A>
            rel physics:body1 = </World/Scene/B>
        }
        def CableJoint "J1" {
            rel physics:body0 = </World/Scene/B>
            rel physics:body1 = </World/Scene/C>
            point3d localPos0 = (0.1, 0.3, 0.2)
            double restLength = 0.75
        }
        def CableJoint "J2" {
            rel physics:body0 = </World/Scene/C>
            rel physics:body1 = </World/Scene/D>
        }
        def Xform "AutoPath" (apiSchemas = ["CablePathAPI"]) {
            rel cablePath:joints = [</World/Scene/J0>, </World/Scene/J1>, </World/Scene/J2>]
            token[] cablePath:linkTypes = ["hybrid", "rolling", "rolling", "attachment"]
            bool[] cablePath:clockwise = [1, 0, 1, 0]
            double[] cablePath:stored = [2, 0.03, 9, 0]
            token[] cablePath:storedMode = ["manual", "manual", "auto", "manual"]
            double cablePath:halfWidth = 0.001
        }
        def CableJoint "ManualJoint" {
            rel physics:body0 = </World/Scene/A>
            rel physics:body1 = </World/Scene/D>
            point3d localPos0 = (0.01, 0.02, 0.03)
            point3d localPos1 = (-0.03, -0.02, -0.01)
            double restLength = 1.25
        }
        def Xform "ManualPath" (apiSchemas = ["CablePathAPI"]) {
            rel cablePath:joints = [</World/Scene/ManualJoint>]
            token[] cablePath:linkTypes = ["hybrid", "attachment"]
            bool[] cablePath:clockwise = [0, 1]
            double[] cablePath:stored = [0.5, 0.1]
            token cablePath:initPolicy = "manual"
        }
    }
}
