{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autocal/full_auto_log_entry.schema.json",
  "title": "Autocal Full Auto JSONL Entry",
  "type": "object",
  "required": [
    "timestamp",
    "dataset"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "dataset": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
