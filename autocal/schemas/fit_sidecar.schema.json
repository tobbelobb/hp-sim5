{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autocal/fit_sidecar.schema.json",
  "title": "Autocal Ellipse Fit Sidecar",
  "type": "object",
  "required": [
    "source",
    "residual_threshold",
    "min_points",
    "fitted_ellipses"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "residual_threshold": {
      "type": "number"
    },
    "min_points": {
      "type": "integer",
      "minimum": 1
    },
    "fitted_ellipses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "valid"
        ],
        "properties": {
          "sweep_id": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "rejection_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "coefficients": {
            "type": "object",
            "required": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ],
            "properties": {
              "A": {
                "type": "number"
              },
              "B": {
                "type": "number"
              },
              "C": {
                "type": "number"
              },
              "D": {
                "type": "number"
              },
              "E": {
                "type": "number"
              },
              "F": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
