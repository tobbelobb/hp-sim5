diff --git a/autocal/control/tests/primitives/return_to_origin_one_at_a_time.test.mjs b/autocal/control/tests/primitives/return_to_origin_one_at_a_time.test.mjs
index 6adab260..f2fbb5c7 100644
--- a/autocal/control/tests/primitives/return_to_origin_one_at_a_time.test.mjs
+++ b/autocal/control/tests/primitives/return_to_origin_one_at_a_time.test.mjs
@@ -108,4 +108,43 @@ describe('returnMotorsToOriginOneAtATime', () => {
     expect(lengths).toEqual([0]);
     expect(postMoveReads).toBeGreaterThan(1);
   });
+  test('reuses the held quiet check for an all-zero return without releasing other motors', async () => {
+    let nowMs = 0;
+    const commands = [];
+    const send = async line => { commands.push(line); return { reply: '0 0 0 0' }; };
+    send.simulationClock = { now: () => nowMs, sleep: async ms => { nowMs += ms; } };
+    const result = await returnMotorsToOriginOneAtATime(send, {
+      motorIds: ['40.0', '41.0', '42.0', '43.0'], axes: ['X', 'Y', 'Z', 'U'],
+      mmPerDeg: [1, 1, 1, 1], feed: 1400, forbiddenForceAnchors: [3],
+    });
+    expect(result).toEqual([0, 0, 0, 0]);
+    expect(nowMs).toBe(1500);
+    expect(commands.filter(line => line.startsWith('M569.4'))).toEqual([
+      'M569.4 P40.0:41.0:42.0:43.0 T0.0:0.0:0.0:0.0',
+    ]);
+  });
+
+  test('invalidates the quiet check after a move and observes another motor pulled away from zero', async () => {
+    let nowMs = 0;
+    const angles = [10, 0, 0, 0];
+    const commands = [];
+    const send = async line => {
+      commands.push({ line, nowMs });
+      if (line.startsWith('G1 H2 X')) { angles[0] = 0; angles[1] = 5; }
+      if (line.startsWith('G1 H2 Y')) angles[1] = 0;
+      return { reply: angles.join(' ') };
+    };
+    send.simulationClock = { now: () => nowMs, sleep: async ms => { nowMs += ms; } };
+    const result = await returnMotorsToOriginOneAtATime(send, {
+      motorIds: ['40.0', '41.0', '42.0', '43.0'], axes: ['X', 'Y', 'Z', 'U'],
+      mmPerDeg: [1, 1, 1, 1], feed: 1400, forbiddenForceAnchors: [3],
+    });
+    const moves = commands.filter(command => command.line.startsWith('G1 H2'));
+    expect(moves.map(command => command.line)).toEqual(['G1 H2 X-10.000 F1400', 'G1 H2 Y-5.000 F1400']);
+    expect(moves[0].nowMs).toBe(1500);
+    expect(moves[1].nowMs).toBeGreaterThanOrEqual(moves[0].nowMs + 1500);
+    expect(result).toEqual([0, 0, 0, 0]);
+    expect(commands.at(-1).nowMs).toBeGreaterThanOrEqual(moves[1].nowMs + 1500);
+  });
+
 });
