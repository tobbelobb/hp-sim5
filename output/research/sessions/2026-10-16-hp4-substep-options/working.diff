+  const world = new World();
+  const listeners = {};
+  const select = {
+    options: [{ value: '1' }, { value: '4' }], value: '1',
+    ownerDocument: { createElement: () => ({}) },
+    add(option) { this.options.push(option); },
+    addEventListener(type, handler) { listeners[type] = handler; },
+  };
